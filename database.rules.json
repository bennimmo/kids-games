{
  "rules": {
    "games": {
      "$game": {
        "rooms": {
          "$code": {
            ".read": "auth != null",
            ".write": "auth != null && (data.child('host').val() === auth.uid || (!data.exists() && newData.child('host').val() === auth.uid))",
            "players": {
              "$pid": {
                ".write": "auth != null && $pid.beginsWith(auth.uid + '_')"
              }
            },
            "live": {
              "$pid": {
                ".write": "auth != null && $pid.beginsWith(auth.uid + '_')"
              }
            }
          }
        }
      }
    }
  }
}
